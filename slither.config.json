{
  "detectors_to_exclude": [
    "naming-convention",
    "similar-names",
    "too-many-digits",
    "constable-states",
    "dead-code",
    "solc-version",
    "pragma",
    "timestamp"
  ],
  "exclude_informational": true,
  "exclude_low": true,
  "exclude_medium": false,
  "exclude_high": false,  
  "fail_on": "none",
  "filter_paths": "contracts/lib|contracts/test|contracts/src/Create2DeployerLocal.sol|@openzeppelin|hardhat/console.sol|xdeployer",
  "solc_remaps": [
    "solady/=contracts/lib/solady/",
    "forge-std/=contracts/lib/forge-std/",
    "@openzeppelin/=node_modules/@openzeppelin/"
  ],
  "foundry_out_directory": "forge-artifacts"
}
